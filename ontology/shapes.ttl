@prefix zg: <https://example.org/cps310/zombie-ontology#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

# Executed with pyshacl as a second, independent acceptance gate.
# Each evidence graph represents a single demonstration tick, so inverse
# sourceHuman maxCount implements one-conversion-per-human for that tick.

zg:BiteShape a sh:NodeShape ;
    sh:targetClass zg:BiteEvent ;
    sh:property [
        sh:path zg:actor ;
        sh:class zg:Zombie ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path zg:target ;
        sh:class zg:Human ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] .

zg:ConversionShape a sh:NodeShape ;
    sh:targetClass zg:ConversionEvent ;
    sh:property [
        sh:path zg:sourceHuman ;
        sh:class zg:Human ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path zg:createdZombie ;
        sh:class zg:Zombie ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] .

zg:HumanConvertedAtMostOnceShape a sh:NodeShape ;
    sh:targetClass zg:Human ;
    sh:property [
        sh:path [ sh:inversePath zg:sourceHuman ] ;
        sh:maxCount 1 ;
        sh:message "A human can be converted at most once per demonstration tick."
    ] .

zg:PredictionShape a sh:NodeShape ;
    sh:targetClass zg:Prediction ;
    sh:property [
        sh:path zg:computedBy ;
        sh:class zg:ForecastObserver ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path zg:predictedCount ;
        sh:datatype xsd:integer ;
        sh:minInclusive 0 ;
        sh:lessThanOrEquals zg:populationCapacity ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path zg:populationCapacity ;
        sh:datatype xsd:integer ;
        sh:minInclusive 1 ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] .

# The count snapshot includes the number of all surviving agents.
zg:PopulationSnapshotShape a sh:NodeShape ;
    sh:targetClass zg:PopulationSnapshot ;
    sh:property [
        sh:path zg:zombieCount ;
        sh:datatype xsd:integer ;
        sh:minInclusive 0 ;
        sh:lessThanOrEquals zg:initialPopulation ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path zg:survivingAgents ;
        sh:datatype xsd:integer ;
        sh:minInclusive 0 ;
        sh:lessThanOrEquals zg:initialPopulation ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path zg:initialPopulation ;
        sh:datatype xsd:integer ;
        sh:minInclusive 1 ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] .
